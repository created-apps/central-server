PORT=4100
CORS_ORIGINS=http://localhost:3000

# This app's own Supabase project (fill in)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Verifies sign-in sessions. Must match AUTH_SECRET in frontend/.env.local.
AUTH_SECRET=
# Sent as the X-API-Key header to call POST /api/milestones/evaluate from
# other services. Generate with: openssl rand -hex 32
MILESTONE_API_KEY=

# Sources (read-only), copied from booking-platform-clean/backend/.env
SYNC_SUPABASE_URL=
SYNC_SERVICE_ROLE_KEY=
COSMIC_SUPABASE_URL=
COSMIC_SERVICE_ROLE_KEY=
AUTOMATIONS_SUPABASE_URL=
AUTOMATIONS_SERVICE_ROLE_KEY=
COSMIC_SCOPE_BUCKET=project-scopes
COSMIC_SIGNED_URL_TTL=3600
ENROLLMENT_SHEET_CREDENTIALS_BASE64=
ENROLLMENT_SHEET_ID=
ENROLLMENT_SHEET_TAB=

# Hourly at minute 5
SYNC_CRON=5 * * * *
SYNC_CRON_ENABLED=true
SYNC_CONCURRENCY=6

# Drive service account: exports progress-report Docs to PDF (read-only)
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=

# LLM progress update
ANTHROPIC_API_KEY=
CLAUDE_PROGRESS_MODEL=claude-sonnet-5-5
